{
  "name": "agents",
  "version": "1.0.0",
  "description": "Monitor AI agent panes across tmux sessions",
  "type": "module",
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "bin": {
    "agents": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:binary": "npx --yes bun@1.4.2 scripts/build-binary.ts",
    "dev": "tsc --watch",
    "dev:watch": "vite-node -w ./src/cli.ts watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli.js",
    "build:web": "vite build --config web/acp-view/vite.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.100.0",
    "@agentclientprotocol/codex-acp": "2.5.0",
    "commander": "^14.0.3",
    "ink": "^6.8.0",
    "react": "^19.2.4",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "2.4.0",
    "@streamdown/code": "2.0.0",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^5.1.4",
    "react-dom": "19.3.1",
    "streamdown": "2.7.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-node": "^5.3.0",
    "vitest": "^4.1.0",
    "zustand": "5.0.16"
  }
}
